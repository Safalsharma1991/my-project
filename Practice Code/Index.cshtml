@model MGMMVCDemo.Models.Employee

@using (Html.BeginForm("Index", "Employee", FormMethod.Post))
{
    @Html.Label("Enter Eno")
    @Html.TextBoxFor(models => models.Eno)
    <br />

    @Html.Label("Enter Ename")
    @Html.TextBoxFor(models => models.Ename)
    <br />

    @Html.Label("Enter Salary")
    @Html.TextBoxFor(models => models.Salary)
    <br />
    <input type="submit" value="Save" />
}


